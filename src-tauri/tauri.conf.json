{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PassSa",
  "version": "0.1.0",
  "identifier": "id.passsa.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PassSa",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "decorations": false,
        "resizable": true,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../build/icon.ico"]
  }
}
