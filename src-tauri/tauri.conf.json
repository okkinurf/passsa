{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PassSa",
  "version": "0.2.1",
  "identifier": "id.passsa.desktop",
  "build": {
    "frontendDist": "../.tauri/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PassSa",
        "width": 520,
        "height": 580,
        "minWidth": 480,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://api.github.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "dmg"],
    "icon": ["icons-brand/32x32.png", "icons-brand/128x128.png", "icons-brand/128x128@2x.png", "icons-brand/icon.icns", "icons-brand/icon.ico"],
    "resources": {
      "../.tauri/runtime/": "passsa-runtime/"
    }
  }
}
